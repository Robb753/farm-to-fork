# Copy to .env.local. Never commit filled values.
# npm run env:check validates public build configuration without printing values.
# npm run env:check:runtime checks server settings, not provider access.

# Use the same canonical origin in both variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public build/runtime values. Supabase ANON or sb_publishable_ key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server-only. Both Supabase URLs must point to the same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=

# Existing Clerk routing; keep while reconciling the live instance.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/explore
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/welcome
# Code explicitly uses getToken({ template: "supabase" }).
# There is no effective template-name env switch. Do not change auth mode yet.

# Runtime dependencies of existing features; not needed for CI compilation.
RESEND_API_KEY=
INSEE_API_KEY=
ANTHROPIC_API_KEY=

# SMS: all three server values are required when enabled.
NEXT_PUBLIC_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional SEO/analytics: validate their CSP/domains before activation.
GOOGLE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# Existing order-origin behavior. Keep arbitrary preview domains disabled.
NEXT_PUBLIC_ALLOW_VERCEL_PREVIEWS=false
# Optional exact preview hostname consumed by the current orders route:
NEXT_PUBLIC_VERCEL_URL=
